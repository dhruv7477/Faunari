{
  "expo": {
    "name": "Faunari",
    "slug": "faunari",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#15301F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.faunari.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withOrtVersionPin",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Faunari uses the camera so you can photograph a snake from a safe distance.",
          "photosPermission": "Faunari needs photo access to check a snake photo you already took."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1310584b-7038-449e-a494-251d9a1de414"
      }
    },
    "owner": "dhruv7477"
  }
}
