{
  "expo": {
    "name": "Faunari",
    "slug": "faunari",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#123524"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.faunari.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123524"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "./plugins/withOrtVersionPin",
      "./plugins/withAndroidAbis",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Faunari uses the camera so you can photograph a snake from a safe distance.",
          "photosPermission": "Faunari needs photo access to check a snake photo you already took."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "lib/**/libreactnative.so",
                "lib/**/libjsi.so",
                "lib/**/libc++_shared.so",
                "lib/**/libfbjni.so"
              ]
            },
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class ai.onnxruntime.** { *; }"
          }
        }
      ],
      "expo-asset",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "1310584b-7038-449e-a494-251d9a1de414"
      }
    },
    "owner": "dhruv7477"
  }
}
