# Copy to mobile/.env.local (gitignored) and fill in, then restart `npx expo start --dev-client`.
#
# Where the app downloads the model from on first run (no trailing slash).
# Hugging Face private repo: https://huggingface.co/<user>/faunari-models/resolve/main
EXPO_PUBLIC_MODEL_BASE_URL=

# Fine-grained READ token for that repo only (hf_...). Required for private hosting.
# NEVER commit the real token; .env.local is gitignored.
EXPO_PUBLIC_MODEL_TOKEN=

# --- Phase 2b: Firebase feedback backend (from the Web app's firebaseConfig) ---
# These are not secret (Firebase web configs are meant to be embedded; security is enforced by
# rules). Leave blank to keep feedback local-only (no upload attempted).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
